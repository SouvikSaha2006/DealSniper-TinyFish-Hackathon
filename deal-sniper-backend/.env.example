# TinyFish API Credentials (replace with your TinyFish key)
TINYFISH_API_KEY=sk-tinyfish-your-api-key-here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
USE_MOCK_FALLBACK=false

# TinyFish Service Endpoints
TINYSEARCH_URL=https://api.search.tinyfish.ai
TINYFETCH_URL=https://api.fetch.tinyfish.ai
TINYAGENT_SSE_URL=https://agent.tinyfish.ai/v1/automation/run-sse
